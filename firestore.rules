rules_version = '2';

// CT-SMART EDUC — Firestore Security Rules (Spark plan, no Cloud Functions)
//
// Access model:
// There are exactly three named Firebase Authentication accounts:
//   founder@ctsmart.educ, teacher@ctsmart.educ, learner@ctsmart.educ
// No anonymous accounts are ever created — a person's "code" is the
// password for one of these fixed accounts, and entering it signs them
// into that real account via Firebase Authentication itself.
//
// These Firestore rules are what actually enforce "only the Founder can
// view or change codes." The app's own JavaScript checks only protect the
// UI — anyone can open dev tools and call the Firestore SDK directly,
// bypassing index.html entirely. These rules run on Firebase's servers.
//
// Deploy with the Firebase CLI:
//   firebase deploy --only firestore:rules
// or paste this file's contents into:
//   Firebase Console -> Firestore Database -> Rules

service cloud.firestore {
  match /databases/{database}/documents {

    // schoolAccess/public
    // Contains NO secrets -- just which system accounts exist, whether
    // Teacher/Learner sign-in is locked, and the setup status. Must stay
    // publicly readable so the app can show the right screen before anyone
    // signs in. Only the Founder account may write to it.
    match /schoolAccess/public {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'founder@ctsmart.educ';
    }

    // schoolAccess/admin
    // Holds the Founder's UID plus the CURRENT plaintext Teacher and
    // Learner codes (kept here purely so the Founder can view/reuse them
    // when changing a code -- see index.html). This must be readable and
    // writable ONLY by the Founder account; nobody else may ever read it.
    match /schoolAccess/admin {
      allow read, write: if request.auth != null
                   && request.auth.token.email == 'founder@ctsmart.educ';
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
